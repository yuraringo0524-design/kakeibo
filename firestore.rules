rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // ユーザー本人のプロフィール（表示名・所属グループID）
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // 家計グループ本体（名前・メンバー・招待コード）
    match /groups/{groupId} {
      // 作成：自分だけをメンバーとして持つグループを作れる
      allow create: if isSignedIn() &&
        request.resource.data.adminId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid];

      // グループ名・招待コード・メンバー一覧は家計の中身（取引明細など）ではないため、
      // 招待コードで検索できるようサインイン済みなら誰でも読み取り可能にする。
      // （取引明細など実際の家計データは下の isMember チェックで別途保護される）
      allow get, list: if isSignedIn();

      // 更新：既存メンバーは自由に更新できる。
      // まだメンバーでない人は「自分を追加する更新」だけ許可（招待コード参加のため）。
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;

      // 家計データ本体（明細・カテゴリ・支払い方法・予算・定期取引・貯金目標・通知設定）
      match /{collection}/{docId} {
        allow read, write: if isMember(groupId);
      }
    }
  }
}
